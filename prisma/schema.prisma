generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // ADMIN, STAFF
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceCategory {
  id          String          @id @default(uuid())
  name        String          @unique
  slug        String          @unique
  description String?
  image       String?
  displayOrder Int            @default(0)
  services    Service[]
  portfolio   PortfolioItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Service {
  id                String          @id @default(uuid())
  name              String
  slug              String          @unique
  image             String?
  description       String
  categoryId        String
  category          ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  basePrice         Float
  discountPercent   Float           @default(0)
  estimatedDelivery String
  isFeatured        Boolean         @default(false)
  isHidden          Boolean         @default(false)
  status            String          @default("ACTIVE") // ACTIVE, INACTIVE
  pricingRules      PricingRule[]
  orders            Order[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PricingRule {
  id              String   @id @default(uuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  minQuantity     Int
  maxQuantity     Int
  unitPrice       Float
  discountPercent Float    @default(0)
  createdAt       DateTime @default(now())
}

model PortfolioItem {
  id          String          @id @default(uuid())
  title       String
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  image       String
  description String?
  isFeatured  Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

model Order {
  id                   String          @id @default(uuid())
  orderId              String          @unique // e.g. MPZ-8F3K9P2Q
  customerName         String
  customerPhone        String
  customerEmail        String
  serviceId            String
  service              Service         @relation(fields: [serviceId], references: [id])
  quantity             Int
  unitPrice            Float
  subtotal             Float
  discountAmount       Float           @default(0)
  gstAmount            Float           @default(0)
  deliveryCharge       Float           @default(0)
  grandTotal           Float
  notes                String?
  designFileUrl        String?
  designFileName       String?
  status               String          @default("PENDING") // PENDING, APPROVED, DESIGN_REVIEW, PRINTING, READY, DELIVERED, CANCELLED
  paymentStatus        String          @default("UNPAID") // UNPAID, PAID, PARTIAL
  expectedDeliveryDate String?
  timeline             OrderTimeline[]
  invoice              Invoice?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model OrderTimeline {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdBy String?  @default("System")
  createdAt DateTime @default(now())
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique // e.g. INV-MPZ-2026-0001
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issueDate     DateTime @default(now())
  dueDate       DateTime
  subtotal      Float
  taxAmount     Float
  grandTotal    Float
  paymentStatus String   @default("UNPAID")
  pdfUrl        String?
  createdAt     DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general") // general, hero, contact, pricing, social
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(uuid())
  customerName String
  photo        String?
  review       String
  rating       Int      @default(5)
  isFeatured   Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
}

model Offer {
  id              String    @id @default(uuid())
  code            String    @unique
  title           String
  discountPercent Float
  expiryDate      DateTime?
  isActive        Boolean   @default(true)
  minOrderValue   Float     @default(0)
  createdAt       DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  type      String // NEW_ORDER, PAYMENT_RECEIVED, INVOICE_GENERATED, CUSTOMER_MESSAGE
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
