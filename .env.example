# PostgreSQL Database Connection (Neon, Supabase, AWS RDS, Render)
# For local development with SQLite, use: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret Key for Session Signatures (Use a random long secret in production)
JWT_SECRET="mpz_super_secret_jwt_key_2026_production_safe_token"

# Cloudinary Integration (For storing customer artwork uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Resend API Key (For automated email order alerts)
RESEND_API_KEY="re_123456789_your_resend_key"
SENDER_EMAIL="orders@mountprintzone.com"

# Public App Base URL
NEXT_PUBLIC_APP_URL="https://mountprintzone.com"
